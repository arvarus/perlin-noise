{
  "name": "@arvarus/trouz",
  "version": "2.0.0",
  "description": "Procedural noise toolkit in TypeScript: Perlin noise in 1 to 10 dimensions",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node scripts/mark-dist-formats.mjs",
    "test:package": "node scripts/check-package.mjs",
    "watch": "tsc --watch",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "example:basic": "npm run build && ts-node --project examples/tsconfig.json examples/basic.ts",
    "example:ascii": "npm run build && ts-node --project examples/tsconfig.json examples/ascii-terrain.ts",
    "example:image": "npm run build && ts-node --project examples/tsconfig.json examples/pgm-image.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "trouz",
    "perlin",
    "perlin-noise",
    "noise",
    "procedural",
    "generation",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "overrides": {
    "minimatch": ">=10.2.3",
    "test-exclude": "^7.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "jest": "^30.4.2",
    "jiti": "^2.6.1",
    "prettier": "^3.9.5",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arvarus/trouz.git"
  }
}
